<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>🔑 Ollama Key Proxy Dashboard</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #0f172a;
      color: #e2e8f0;
      min-height: 100vh;
      padding: 20px;
    }
    .container { max-width: 1400px; margin: 0 auto; }

    header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 30px;
      padding-bottom: 20px;
      border-bottom: 1px solid #334155;
    }
    h1 { font-size: 1.8rem; color: #f8fafc; display: flex; align-items: center; gap: 12px; }
    .badge {
      background: #22c55e;
      color: #000;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
    }
    .badge.warning { background: #f59e0b; }
    .badge.error { background: #ef4444; }

    .status-bar {
      display: flex;
      gap: 20px;
      align-items: center;
    }
    .status-bar .indicator {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.9rem;
    }
    .status-bar .dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #22c55e;
      animation: pulse 2s infinite;
    }
    .status-bar .dot.warning { background: #f59e0b; }
    .status-bar .dot.error { background: #ef4444; }

    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .card {
      background: #1e293b;
      border-radius: 12px;
      padding: 24px;
      border: 1px solid #334155;
    }
    .card h2 {
      font-size: 0.85rem;
      text-transform: uppercase;
      color: #94a3b8;
      margin-bottom: 16px;
      letter-spacing: 0.05em;
    }
    .card .value {
      font-size: 2.5rem;
      font-weight: 700;
      color: #f8fafc;
    }
    .card .value.green { color: #22c55e; }
    .card .value.yellow { color: #f59e0b; }
    .card .value.red { color: #ef4444; }
    .card .sub {
      font-size: 0.85rem;
      color: #64748b;
      margin-top: 4px;
    }

    .progress-bar {
      height: 8px;
      background: #334155;
      border-radius: 4px;
      overflow: hidden;
      margin-top: 12px;
    }
    .progress-bar .fill {
      height: 100%;
      background: linear-gradient(90deg, #22c55e, #4ade80);
      transition: width 0.5s ease;
    }
    .progress-bar .fill.warning {
      background: linear-gradient(90deg, #f59e0b, #fbbf24);
    }
    .progress-bar .fill.error {
      background: linear-gradient(90deg, #ef4444, #f87171);
    }

    .keys-section {
      background: #1e293b;
      border-radius: 12px;
      padding: 24px;
      border: 1px solid #334155;
    }
    .keys-section h2 {
      font-size: 1.1rem;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .keys-table {
      width: 100%;
      border-collapse: collapse;
    }
    .keys-table th {
      text-align: left;
      padding: 12px;
      color: #64748b;
      font-weight: 500;
      font-size: 0.8rem;
      text-transform: uppercase;
      border-bottom: 1px solid #334155;
    }
    .keys-table td {
      padding: 16px 12px;
      border-bottom: 1px solid #1e293b;
    }
    .keys-table tr:hover { background: #0f172a; }

    .key-id {
      font-family: monospace;
      background: #334155;
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 0.85rem;
    }
    .key-mask {
      font-family: monospace;
      color: #94a3b8;
    }
    .key-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border-radius: 20px;
      font-size: 0.8rem;
      font-weight: 500;
    }
    .key-status.active {
      background: rgba(34, 197, 94, 0.15);
      color: #22c55e;
    }
    .key-status.cooling {
      background: rgba(239, 68, 68, 0.15);
      color: #ef4444;
    }
    .key-status .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }

    .stats-cell {
      display: flex;
      gap: 16px;
      font-size: 0.85rem;
    }
    .stats-cell span {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .stats-cell .success { color: #22c55e; }
    .stats-cell .fail { color: #ef4444; }
    .stats-cell .rate { color: #f59e0b; }

    .config-section {
      background: #1e293b;
      border-radius: 12px;
      padding: 24px;
      border: 1px solid #334155;
      margin-top: 20px;
    }
    .config-section h2 { font-size: 1.1rem; margin-bottom: 16px; }
    .config-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 16px;
    }
    .config-item {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .config-item label {
      font-size: 0.75rem;
      color: #64748b;
      text-transform: uppercase;
    }
    .config-item span {
      font-family: monospace;
      color: #94a3b8;
    }

    .footer {
      text-align: center;
      margin-top: 30px;
      padding: 20px;
      color: #475569;
      font-size: 0.8rem;
    }

    @media (max-width: 768px) {
      .keys-table { display: block; overflow-x: auto; }
      .grid { grid-template-columns: 1fr 1fr; }
    }
  </style>
  <meta http-equiv="refresh" content="5">
</head>
<body>
  <div class="container">
    <header>
      <h1>
        🔑 Ollama Key Proxy
        <span class="badge" id="statusBadge">
          <%= global.totalRequests > 0 ? 'LIVE' : 'READY' %>
        </span>
      </h1>
      <div class="status-bar">
        <div class="indicator">
          <div class="dot <%= keys.filter(k => k.status === 'active').length === 0 ? 'error' : '' %>"></div>
          <span><%= keys.filter(k => k.status === 'active').length %> / <%= keys.length %> Keys Active</span>
        </div>
        <div class="indicator">
          <span>Uptime: <%= global.uptime %></span>
        </div>
      </div>
    </header>

    <div class="grid">
      <div class="card">
        <h2>Total Requests</h2>
        <div class="value"><%= global.totalRequests.toLocaleString() %></div>
        <div class="sub">Since startup</div>
      </div>

      <div class="card">
        <h2>Success Rate</h2>
        <div class="value <%= global.successRate >= 90 ? 'green' : global.successRate >= 70 ? 'yellow' : 'red' %>">
          <%= global.successRate %>%
        </div>
        <div class="progress-bar">
          <div class="fill <%= global.successRate >= 90 ? '' : global.successRate >= 70 ? 'warning' : 'error' %>"
               style="width: <%= global.successRate %>"></div>
        </div>
      </div>

      <div class="card">
        <h2>Successful</h2>
        <div class="value green"><%= global.totalSuccesses.toLocaleString() %></div>
        <div class="sub">200 OK responses</div>
      </div>

      <div class="card">
        <h2>Failed</h2>
        <div class="value <%= global.totalFailures > 0 ? 'red' : '' %>">
          <%= global.totalFailures.toLocaleString() %>
        </div>
        <div class="sub">Errors & rate limits</div>
      </div>
    </div>

    <div class="keys-section">
      <h2>📊 API Keys Status</h2>
      <table class="keys-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Key</th>
            <th>Status</th>
            <th>Requests</th>
            <th>Success</th>
            <th>Failed</th>
            <th>Rate Limited</th>
            <th>Last Used</th>
          </tr>
        </thead>
        <tbody>
          <% keys.forEach(function(k) { %>
            <tr>
              <td><span class="key-id">#<%= k.id %></span></td>
              <td><span class="key-mask"><%= k.key %></span></td>
              <td>
                <span class="key-status <%= k.status %>">
                  <span class="dot"></span>
                  <%= k.status === 'active' ? 'Active' : 'Cooling (' + Math.max(0, Math.ceil((k.disabledUntil - Date.now()) / 1000)) + 's)' %>
                </span>
              </td>
              <td><%= k.requests %></td>
              <td class="success"><%= k.successes %></td>
              <td class="fail"><%= k.failures %></td>
              <td class="rate"><%= k.rateLimits %></td>
              <td><%= k.lastUsed ? new Date(k.lastUsed).toLocaleTimeString() : 'Never' %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>

    <div class="config-section">
      <h2>⚙️ Configuration</h2>
      <div class="config-grid">
        <div class="config-item">
          <label>Port</label>
          <span><%= config.port %></span>
        </div>
        <div class="config-item">
          <label>Target URL</label>
          <span><%= config.target %></span>
        </div>
        <div class="config-item">
          <label>Cooldown</label>
          <span><%= config.cooldown %>ms</span>
        </div>
        <div class="config-item">
          <label>Total Keys</label>
          <span><%= keys.length %></span>
        </div>
      </div>
    </div>

    <div class="footer">
      <p>Auto-refreshing every 5 seconds • <%= new Date().toLocaleString() %></p>
    </div>
  </div>
</body>
</html>
